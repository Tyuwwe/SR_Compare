#version 450
// 9-tap separable Gaussian at half resolution.  params.xy is the step in
// pixels (1,0) or (0,1).  Same BloomPush layout as bloom_extract.comp.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dst;

layout(push_constant) uniform Push {
    vec4 params; // xy = blur direction in pixels
} pc;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (pix.x >= size.x || pix.y >= size.y) return;

    const float w[5] = float[5](0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);
    vec2 texel = 1.0 / vec2(size);
    vec2 uv = (vec2(pix) + 0.5) * texel;
    vec2 dir = pc.params.xy * texel;
    vec3 sum = texture(src, uv).rgb * w[0];
    for (int i = 1; i < 5; ++i) {
        vec2 off = dir * float(i);
        sum += texture(src, uv + off).rgb * w[i];
        sum += texture(src, uv - off).rgb * w[i];
    }
    imageStore(dst, pix, vec4(sum, 1.0));
}
