#version 450
// GTAO denoise: 5×5 depth-aware bilateral over the working target (R = AO,
// G = view-space |z|).  Matches XeGTAO's "rely on a spatial filter, TAA does
// the temporal part" split; we stay spatial-only so FSR1 / SGSR1 do not
// shimmer.  Output is R16F visibility for lighting.frag / transparent.frag.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D rawAO;
layout(set = 0, binding = 1, r16f) uniform writeonly image2D outAO;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outAO);
    if (pix.x >= size.x || pix.y >= size.y) return;

    vec2 center = texelFetch(rawAO, pix, 0).rg;
    float zc = max(center.g, 1e-3);
    // Relative depth sigma: ~8 % of view Z, so contact shadows stay sharp
    // while the Hilbert noise averages out on flat walls.
    float sigmaZ = 0.08 * zc;
    float invTwoSigmaZ2 = 1.0 / max(2.0 * sigmaZ * sigmaZ, 1e-6);

    float sum = 0.0;
    float wsum = 0.0;
    for (int y = -2; y <= 2; ++y) {
        for (int x = -2; x <= 2; ++x) {
            ivec2 p = clamp(pix + ivec2(x, y), ivec2(0), size - 1);
            vec2 s = texelFetch(rawAO, p, 0).rg;
            float spatial = exp(-0.5 * float(x * x + y * y) / 2.25);
            float range = exp(-(s.g - zc) * (s.g - zc) * invTwoSigmaZ2);
            float w = spatial * range;
            sum += s.r * w;
            wsum += w;
        }
    }
    imageStore(outAO, pix, vec4(sum / max(wsum, 1e-5)));
}
