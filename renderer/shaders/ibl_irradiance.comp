#version 450
// Diffuse IBL irradiance map: cosine-weighted hemisphere convolution of the
// environment cubemap (samples the deepest mip -> already band-limited).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube envCube;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray dstCube;

layout(push_constant) uniform Push {
    float envMaxLod;
} pc;

const float PI = 3.14159265359;

vec3 cubeDir(uint face, vec2 uv) {
    switch (face) {
    case 0u: return vec3(1.0, -uv.y, -uv.x);
    case 1u: return vec3(-1.0, -uv.y, uv.x);
    case 2u: return vec3(uv.x, 1.0, uv.y);
    case 3u: return vec3(uv.x, -1.0, -uv.y);
    case 4u: return vec3(uv.x, -uv.y, 1.0);
    default: return vec3(-uv.x, -uv.y, -1.0);
    }
}

void main() {
    ivec3 size = imageSize(dstCube);
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (id.x >= size.x || id.y >= size.y) return;
    vec2 uv = (vec2(id.xy) + 0.5) / vec2(size.xy) * 2.0 - 1.0;
    vec3 N = cubeDir(uint(id.z), uv);

    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 right = normalize(cross(up, N));
    up = cross(N, right);

    vec3 irradiance = vec3(0.0);
    float samples = 0.0;
    const float step = 0.06;
    for (float phi = 0.0; phi < 2.0 * PI; phi += step) {
        for (float theta = 0.0; theta < 0.5 * PI; theta += step) {
            vec3 tangent = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
            vec3 dir = tangent.x * right + tangent.y * up + tangent.z * N;
            irradiance += textureLod(envCube, dir, pc.envMaxLod).rgb * cos(theta) * sin(theta);
            samples += 1.0;
        }
    }
    irradiance = PI * irradiance / samples;
    imageStore(dstCube, id, vec4(irradiance, 1.0));
}
