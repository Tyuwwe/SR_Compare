#version 450
// GTAO main pass (Jimenez et al. 2016, XeGTAO-style).
// Replaces the previous Crytek hemisphere SSAO.  Same descriptor layout:
//   binding 0 = GBuffer depth, 1 = world normal, 2 = RG16F working target
//     R = raw visibility, G = view-space |z| (clip.w) for the bilateral denoise.
// Three slices × three steps/side (XeGTAO High, 18 depth samples).  No depth
// MIP chain: samples round to pixel centres and texelFetch the full-res depth.
// Spatial-only Hilbert+R2 noise (no per-frame spin) so spatial upscalers do
// not shimmer.  ssao_blur.comp is the 5×5 depth-aware denoise.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D gbDepth;
layout(set = 0, binding = 1) uniform sampler2D gbNormal;
layout(set = 0, binding = 2, rg16f) uniform writeonly image2D outAO;

layout(push_constant) uniform Push {
    mat4 viewProj;    // matches the GBuffer pass of this path
    vec4 params;      // x = radius (m), w = final power
    vec4 params2;     // unused (frame index reserved)
} pc;

const float PI = 3.14159265359;
const float PI_HALF = 1.57079632679;
const int kSliceCount = 3;
const int kStepsPerSlice = 3;
const float kSampleDistributionPower = 2.0;
const float kFalloffRange = 0.615;
const float kRadiusMultiplier = 1.457;
const float kPixelTooClose = 1.3;

// 64×64 Hilbert index (XeGTAO / shadertoy paniq).
uint hilbertIndex(uint posX, uint posY) {
    posX &= 63u;
    posY &= 63u;
    uint index = 0u;
    for (uint curLevel = 32u; curLevel > 0u; curLevel >>= 1u) {
        uint regionX = uint((posX & curLevel) != 0u);
        uint regionY = uint((posY & curLevel) != 0u);
        index += curLevel * curLevel * ((3u * regionX) ^ regionY);
        if (regionY == 0u) {
            if (regionX == 1u) {
                posX = 63u - posX;
                posY = 63u - posY;
            }
            uint tmp = posX;
            posX = posY;
            posY = tmp;
        }
    }
    return index;
}

float fastSqrt(float x) {
    return uintBitsToFloat(0x1fbd1df5u + (floatBitsToUint(x) >> 1u));
}

// [-1,1] -> [0, PI]
float fastACos(float inX) {
    float x = abs(inX);
    float res = (-0.156583 * x + PI_HALF) * fastSqrt(1.0 - x);
    return inX >= 0.0 ? res : PI - res;
}

vec3 reconstructWorld(mat4 invVP, vec2 uv, float depth) {
    vec4 w = invVP * vec4(uv * 2.0 - 1.0, depth, 1.0);
    return w.xyz / w.w;
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outAO);
    if (pix.x >= size.x || pix.y >= size.y) return;

    float depth = texelFetch(gbDepth, pix, 0).r;
    if (depth >= 1.0) {
        imageStore(outAO, pix, vec4(1.0, 1e5, 0.0, 0.0));
        return;
    }

    const mat4 invVP = inverse(pc.viewProj);
    const vec2 invSize = 1.0 / vec2(size);
    vec2 uv = (vec2(pix) + 0.5) * invSize;

    vec3 P = reconstructWorld(invVP, uv, depth);
    float viewZ = abs((pc.viewProj * vec4(P, 1.0)).w);
    viewZ = max(viewZ, 1e-3);

    vec3 N = normalize(texelFetch(gbNormal, pix, 0).xyz * 2.0 - 1.0);

    vec4 nearC = invVP * vec4(uv * 2.0 - 1.0, 0.0, 1.0);
    vec4 farC = invVP * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    nearC /= nearC.w;
    farC /= farC.w;
    vec3 viewVec = normalize(nearC.xyz - farC.xyz); // toward camera
    if (dot(N, viewVec) < 0.0) N = -N;

    const float effectRadius = pc.params.x * kRadiusMultiplier;
    const float falloffRange = kFalloffRange * effectRadius;
    const float falloffFrom = effectRadius * (1.0 - kFalloffRange);
    const float falloffMul = -1.0 / max(falloffRange, 1e-4);
    const float falloffAdd = falloffFrom / max(falloffRange, 1e-4) + 1.0;

    vec3 pRight = reconstructWorld(invVP, uv + vec2(invSize.x, 0.0), depth);
    float worldPerPixel = max(length(pRight - P), 1e-5);
    float screenspaceRadius = effectRadius / worldPerPixel;

    uint h = hilbertIndex(uint(pix.x), uint(pix.y));
    // R2 sequence (Roberts).  Spatial only: temporal offsets shimmer under
    // FSR1 / SGSR1, which have no history to average them out.
    float noiseSlice = fract(0.5 + float(h) * 0.7548776662466927);
    float noiseSample = fract(0.5 + float(h) * 0.5698402739369613);

    float visibility = clamp((10.0 - screenspaceRadius) / 100.0, 0.0, 1.0) * 0.5;
    const float minS = kPixelTooClose / max(screenspaceRadius, kPixelTooClose);

    for (int slice = 0; slice < kSliceCount; ++slice) {
        float sliceK = (float(slice) + noiseSlice) / float(kSliceCount);
        float phi = sliceK * PI;
        float cosPhi = cos(phi);
        float sinPhi = sin(phi);
        vec2 omega = vec2(cosPhi, -sinPhi) * screenspaceRadius;

        vec3 pixelRight = pRight - P;
        vec3 camRight = pixelRight - viewVec * dot(pixelRight, viewVec);
        camRight = length(camRight) > 1e-6 ? normalize(camRight) : vec3(1.0, 0.0, 0.0);
        vec3 camUp = normalize(cross(viewVec, camRight));
        vec3 directionVec = camRight * cosPhi + camUp * sinPhi;
        vec3 orthoDirectionVec = directionVec - dot(directionVec, viewVec) * viewVec;
        vec3 axisVec = normalize(cross(orthoDirectionVec, viewVec));
        vec3 projectedNormalVec = N - axisVec * dot(N, axisVec);

        float signNorm = sign(dot(orthoDirectionVec, projectedNormalVec));
        float projectedNormalVecLength = length(projectedNormalVec);
        float cosNorm = clamp(dot(projectedNormalVec, viewVec) /
                              max(projectedNormalVecLength, 1e-5), 0.0, 1.0);
        float n = signNorm * fastACos(cosNorm);

        float lowHorizonCos0 = cos(n + PI_HALF);
        float lowHorizonCos1 = cos(n - PI_HALF);
        float horizonCos0 = lowHorizonCos0;
        float horizonCos1 = lowHorizonCos1;

        for (int step = 0; step < kStepsPerSlice; ++step) {
            float stepBaseNoise = float(slice + step * kStepsPerSlice) * 0.6180339887498948;
            float stepNoise = fract(noiseSample + stepBaseNoise);
            float s = (float(step) + stepNoise) / float(kStepsPerSlice);
            s = pow(s, kSampleDistributionPower);
            s += minS;

            vec2 sampleOffset = round(s * omega);

            vec2 uv0 = uv + sampleOffset * invSize;
            vec2 uv1 = uv - sampleOffset * invSize;
            uv0 = clamp(uv0, vec2(0.0), vec2(1.0));
            uv1 = clamp(uv1, vec2(0.0), vec2(1.0));

            float d0 = texelFetch(gbDepth, ivec2(uv0 * vec2(size)), 0).r;
            float d1 = texelFetch(gbDepth, ivec2(uv1 * vec2(size)), 0).r;
            vec3 samplePos0 = reconstructWorld(invVP, uv0, min(d0, 0.9999));
            vec3 samplePos1 = reconstructWorld(invVP, uv1, min(d1, 0.9999));

            vec3 sampleDelta0 = samplePos0 - P;
            vec3 sampleDelta1 = samplePos1 - P;
            float sampleDist0 = length(sampleDelta0);
            float sampleDist1 = length(sampleDelta1);

            vec3 sampleHorizonVec0 = sampleDelta0 / max(sampleDist0, 1e-6);
            vec3 sampleHorizonVec1 = sampleDelta1 / max(sampleDist1, 1e-6);

            float weight0 = clamp(sampleDist0 * falloffMul + falloffAdd, 0.0, 1.0);
            float weight1 = clamp(sampleDist1 * falloffMul + falloffAdd, 0.0, 1.0);

            float shc0 = mix(lowHorizonCos0, dot(sampleHorizonVec0, viewVec), weight0);
            float shc1 = mix(lowHorizonCos1, dot(sampleHorizonVec1, viewVec), weight1);

            horizonCos0 = max(horizonCos0, shc0);
            horizonCos1 = max(horizonCos1, shc1);
        }

        projectedNormalVecLength = mix(projectedNormalVecLength, 1.0, 0.05);
        float h0 = -fastACos(clamp(horizonCos1, -1.0, 1.0));
        float h1 = fastACos(clamp(horizonCos0, -1.0, 1.0));
        float iarc0 = (cosNorm + 2.0 * h0 * sin(n) - cos(2.0 * h0 - n)) * 0.25;
        float iarc1 = (cosNorm + 2.0 * h1 * sin(n) - cos(2.0 * h1 - n)) * 0.25;
        visibility += projectedNormalVecLength * (iarc0 + iarc1);
    }

    visibility /= float(kSliceCount);
    visibility = pow(clamp(visibility, 0.0, 1.0), pc.params.w);
    visibility = max(visibility, 0.03);
    imageStore(outAO, pix, vec4(visibility, viewZ, 0.0, 0.0));
}
