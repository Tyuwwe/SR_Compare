#version 450
// SSAO pass (Crytek / John Chapman style): for each GBuffer pixel, 16 samples
// in a normal-oriented hemisphere are projected to the screen and tested
// against the depth buffer.  Positions are reconstructed in world space with
// the inverse of the exact view-projection of this path (jittered for the
// low-res upscaler input).  Sky pixels (far plane) get AO = 1.
// Output: raw (noisy) AO, R16F; ssao_blur.comp filters it afterwards.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D gbDepth;
layout(set = 0, binding = 1) uniform sampler2D gbNormal;
layout(set = 0, binding = 2, r16f) uniform writeonly image2D outAO;

layout(push_constant) uniform Push {
    mat4 viewProj;    // matches the GBuffer pass of this path
    vec4 params;      // x = radius (m), y = bias (m), z = intensity, w = power
    vec4 params2;     // x = frame index (per-frame rotation), y/z/w unused
} pc;

const int kSamples = 16;
const float GOLDEN_ANGLE = 2.39996323;

// Stable integer hash -> [0,1); avoids the precision pitfalls of sin-hashes.
float hash01(uvec2 v) {
    uint h = v.x * 1973u ^ v.y * 9277u;
    h = h * 747796405u + 2891336453u;
    h ^= h >> 16u;
    h *= 2246822519u;
    h ^= h >> 13u;
    return float(h & 0x00FFFFFFu) / 16777216.0;
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outAO);
    if (pix.x >= size.x || pix.y >= size.y) return;

    float depth = texelFetch(gbDepth, pix, 0).r;
    if (depth >= 1.0) { // sky: no occlusion
        imageStore(outAO, pix, vec4(1.0));
        return;
    }

    const mat4 invViewProj = inverse(pc.viewProj);
    const vec2 invSize = 1.0 / vec2(size);

    // World position of this pixel.
    vec2 uv = (vec2(pix) + 0.5) * invSize;
    vec4 wp4 = invViewProj * vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec3 P = wp4.xyz / wp4.w;
    vec3 N = normalize(texelFetch(gbNormal, pix, 0).xyz);

    const float radius = pc.params.x;
    const float bias = pc.params.y;

    // Per-pixel random rotation, additionally rotated every frame (the blur
    // pass plus temporal jitter average the residual noise out).
    float angle = 6.2831853 * fract(hash01(uvec2(pix)) +
                                    fract(pc.params2.x * 0.61803399));

    // TBN around the world-space normal.
    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 T = normalize(cross(up, N));
    vec3 B = cross(N, T);
    mat3 TBN = mat3(T, B, N);

    float occlusion = 0.0;
    for (int i = 0; i < kSamples; ++i) {
        float fi = float(i);
        // Golden-angle spiral over the unit disk, lifted to the hemisphere and
        // rotated by the per-pixel angle; bias samples towards the center.
        float r = sqrt((fi + 0.5) / float(kSamples));
        float theta = fi * GOLDEN_ANGLE + angle;
        vec2 disk = r * vec2(cos(theta), sin(theta));
        float z = sqrt(max(0.0, 1.0 - dot(disk, disk)));
        float scale = mix(0.1, 1.0, (fi / float(kSamples)) * (fi / float(kSamples)));
        vec3 samplePos = P + N * bias + TBN * vec3(disk, z) * (radius * scale);

        vec4 sc = pc.viewProj * vec4(samplePos, 1.0);
        if (sc.w <= 0.0) continue;
        vec3 sndc = sc.xyz / sc.w;
        vec2 suv = sndc.xy * 0.5 + 0.5;
        if (any(lessThan(suv, vec2(0.0))) || any(greaterThan(suv, vec2(1.0)))) continue;

        float sampleDepth = texelFetch(gbDepth, ivec2(suv * vec2(size)), 0).r;
        if (sampleDepth >= 1.0) continue; // sample points at the sky
        // Occluded when the stored surface is nearer than the sample point.
        if (sampleDepth < sndc.z) {
            // Range check with the true world-space distance (Chapman):
            // ignore occluders farther than one radius away.
            vec4 swp4 = invViewProj * vec4(suv * 2.0 - 1.0, sampleDepth, 1.0);
            vec3 storedP = swp4.xyz / swp4.w;
            float rangeW = clamp(1.0 - length(storedP - P) / radius, 0.0, 1.0);
            occlusion += rangeW;
        }
    }

    float ao = clamp(1.0 - (occlusion / float(kSamples)) * pc.params.z, 0.0, 1.0);
    ao = pow(ao, pc.params.w);
    imageStore(outAO, pix, vec4(ao));
}
