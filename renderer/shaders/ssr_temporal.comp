#version 450
// Temporal filter + composite for opaque SSR (Phase 2d).
//
// The trace pass (ssr_opaque.comp) is a deterministic single-ray march: under
// a moving camera the Hi-Z binary refinement lands on different pixels frame
// to frame and the hit confidence flickers, which reads as reflection
// shimmering.  The standard 2020 cure is temporal reuse — reproject the
// previous frame's filtered result, reject stale history, clamp it to the
// current neighbourhood, and blend with an exponential moving average
// (Stachowiak, Stochastic SSR, SIGGRAPH 2015; UE's ScreenSpaceReflections
// temporal pass).  This is the SSR mirror of ssao_temporal.comp and shares
// its reprojection / rejection model and its determinism contract: every
// input derives from the frame index — no wall clock, no real randomness.
//
// What is filtered: the trace target carries the composite DELTA
// conf*(ssrColor*envBRDF - specIbl), i.e. the confidence is premultiplied, so
// one EMA smooths hit/miss flicker and hit-colour noise together (a ray that
// alternates hit/miss converges to the confidence-weighted average instead of
// blinking).  The alpha channel carries the CURRENT frame's view |z| (never
// blended — same convention as AoHistory's G channel) for the depth
// rejection.
//
// Rejection: camera-only reprojection (the current pixel's world position,
// rebuilt from the GBuffer depth, projected with the PREVIOUS frame's
// view-projection; both matrices carry the path's jitter, so the LR path
// reprojects in its own jittered render domain — no half-pixel drift).  The
// history colour is fetched as a depth-validated bilinear: each of the four
// taps contributes its bilinear weight only when its stored view |z| matches
// the reprojection (a truncating single-texel fetch snaps the sub-pixel
// reprojection to the wrong texel under jitter/rotation and read as edge
// flicker; an unvalidated bilinear bleeds the foreground surface across depth
// edges).  History is dropped when no tap validates (disocclusion / screen
// exit) and on the first frame of the path (reset).
//
// Anti-ghosting: valid history is variance-clipped to the current trace's
// 3x3 neighbourhood (mean +- gamma * sigma per channel; the delta can be
// negative, which the clip handles).  A plain min/max box is as wide as the
// worst neighbour — on sharp (low-roughness) reflections the reflected image
// slides across the surface under camera motion while the depth test still
// passes, and the wide box let stale content decay over the whole EMA window
// (the "layered" ghost trails).  The clip distance doubles as a staleness
// signal: the blend weight rises toward 1 in proportion to how far outside
// the box the history lay, so moved reflection content is dropped within a
// frame or two while stationary pixels keep the full EMA accumulation (the
// accumulation of the jittered sharp mip IS the mirror anti-aliasing).
//
// The composite is fused into this pass: each invocation read-modify-writes
// only its own texel of the lit HDR target (out = old + delta * fogT), so a
// third pass / descriptor set is unnecessary and there is no feedback hazard —
// the same argument the pre-Phase-2d in-place pass relied on.
//
// fogT: the lit target's alpha carries the volumetric-fog transmittance
// (written by volfog_composite.comp, which runs BEFORE this pass; lighting
// cleared alpha to 1, so alpha == 1 when fog is off).  The trace delta
// replaces the PRE-fog specIbl term (conf*(ssrColor*envBRDF - specIbl)), but
// by the time this pass runs, fog has already attenuated that term to
// t*specIbl.  Compositing the raw delta subtracts conf*specIbl in full —
// negative overshoot whenever conf > t, which read as black distant ground in
// fog (Bistro street).  Scaling the whole delta by t reproduces exactly the
// result of compositing SSR before the fog pass:
//   (direct + specIbl)*t + inscatter + t*conf*(hit - specIbl)
//     == (direct + (1-conf)*specIbl + conf*hit)*t + inscatter
// so fogged pixels smoothly keep their IBL/fog colour instead of going black,
// while near / fog-free pixels (t ≈ 1) are unchanged.  (The hit colour itself
// is sampled from the post-fog colour pyramid, i.e. it carries the fog of the
// hit location and is then attenuated by the pixel's t as well — a benign
// approximation, far smaller than the specIbl overshoot this fixes.)
//
// bindings: 0 = trace target (rgb = delta, a = view |z|; SHADER_READ_ONLY)
//           1 = history read  (the OTHER ping-pong buffer, GENERAL)
//           2 = history write (this frame's buffer, GENERAL storage)
//           3 = GBuffer depth (NDC, SHADER_READ_ONLY) for reconstruction
//           4 = lit HDR scene colour (GENERAL storage, in/out RMW composite)
//
// Ref: Stachowiak, Stochastic SSR, SIGGRAPH 2015
//      UE4 ScreenSpaceReflectionsTemporal / SSRTReflections.usf

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D traceTex;
layout(set = 0, binding = 1) uniform sampler2D history;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D outHistory;
layout(set = 0, binding = 3) uniform sampler2D gbDepth;
layout(set = 0, binding = 4, rgba16f) uniform image2D sceneColor;

layout(push_constant) uniform Push {
    mat4 invViewProj;  // current frame (this path's convention; jittered for LR)
    mat4 prevViewProj; // previous frame, same path/convention
    vec4 params;       // x = EMA blend weight, y = reset (1 = pass-through)
} pc;

const float kDepthReject = 0.04; // relative view-Z tolerance (mirror of the host constant)
const float kClipGamma = 1.25;   // variance-clip width in neighbourhood sigmas

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outHistory);
    if (pix.x >= size.x || pix.y >= size.y) return;

    vec4 cur = texelFetch(traceTex, pix, 0);
    float depth = texelFetch(gbDepth, pix, 0).r;
    // First frame of the path (history uninitialised) and sky pixels pass
    // through unblended; storing cur verbatim keeps a = current view |z| (0
    // for sky, which also breaks the depth test) so the NEXT frame can
    // already accumulate.
    if (pc.params.y > 0.5 || depth >= 1.0) {
        imageStore(outHistory, pix, cur);
        if (depth < 1.0) {
            vec4 old = imageLoad(sceneColor, pix);
            imageStore(sceneColor, pix, vec4(old.rgb + cur.rgb * old.a, old.a));
        }
        return;
    }

    vec2 uv = (vec2(pix) + 0.5) / vec2(size);
    vec4 w = pc.invViewProj * vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec3 worldPos = w.xyz / w.w;
    vec4 prevClip = pc.prevViewProj * vec4(worldPos, 1.0);

    vec3 delta = cur.rgb;
    if (prevClip.w > 0.0) {
        vec2 prevUv = prevClip.xy / prevClip.w * 0.5 + 0.5;
        if (all(greaterThan(prevUv, vec2(0.0))) && all(lessThan(prevUv, vec2(1.0)))) {
            const float prevViewZ = abs(prevClip.w);
            const float tol = max(prevViewZ * kDepthReject, 0.01);
            // Depth-validated bilinear history fetch: a tap counts only when
            // its stored view |z| matches the reprojected surface, so depth
            // edges neither snap (truncation) nor bleed (plain bilinear).
            const vec2 hPos = prevUv * vec2(size) - 0.5;
            const ivec2 hBase = ivec2(floor(hPos));
            const vec2 hFrac = hPos - vec2(hBase);
            vec3 histSum = vec3(0.0);
            float histW = 0.0;
            for (int ty = 0; ty <= 1; ++ty) {
                for (int tx = 0; tx <= 1; ++tx) {
                    const float w = (tx == 0 ? 1.0 - hFrac.x : hFrac.x) *
                                    (ty == 0 ? 1.0 - hFrac.y : hFrac.y);
                    if (w <= 0.0) continue;
                    const ivec2 tp = clamp(hBase + ivec2(tx, ty), ivec2(0), size - 1);
                    const vec4 tap = texelFetch(history, tp, 0);
                    if (abs(tap.a - prevViewZ) <= tol) {
                        histSum += tap.rgb * w;
                        histW += w;
                    }
                }
            }
            if (histW > 0.0) {
                const vec3 hist = histSum / histW;
                // Variance clip to the current trace's 3x3 neighbourhood:
                // mean +- kClipGamma * sigma per channel — tighter than the
                // min/max box, so sliding reflection content cannot hide
                // behind a single extreme neighbour.
                vec3 m1 = vec3(0.0);
                vec3 m2 = vec3(0.0);
                for (int dy = -1; dy <= 1; ++dy) {
                    for (int dx = -1; dx <= 1; ++dx) {
                        const ivec2 np = clamp(pix + ivec2(dx, dy), ivec2(0), size - 1);
                        const vec3 n = texelFetch(traceTex, np, 0).rgb;
                        m1 += n;
                        m2 += n * n;
                    }
                }
                const vec3 mean = m1 * (1.0 / 9.0);
                const vec3 sigma = sqrt(max(m2 * (1.0 / 9.0) - mean * mean, vec3(0.0)));
                const vec3 histClip = clamp(hist, mean - kClipGamma * sigma,
                                            mean + kClipGamma * sigma);
                // Staleness-driven blend: history far outside the clip box is
                // moved/stale reflection content — drop it within a frame or
                // two instead of letting it decay over the whole EMA window.
                const vec3 dev = abs(hist - histClip);
                const vec3 staleV = clamp(dev / (sigma + 1e-4), 0.0, 1.0);
                const float stale = max(staleV.r, max(staleV.g, staleV.b));
                delta = mix(histClip, cur.rgb, max(pc.params.x, stale));
            }
        }
    }
    imageStore(outHistory, pix, vec4(delta, cur.a));

    // Fused composite: adding the filtered delta (scaled by the fog
    // transmittance in scene alpha, see the header) reproduces the old
    // in-place mix(iblSpec, ssrColor*envBRDF, conf) on the specular term.
    vec4 old = imageLoad(sceneColor, pix);
    imageStore(sceneColor, pix, vec4(old.rgb + delta * old.a, old.a));
}
