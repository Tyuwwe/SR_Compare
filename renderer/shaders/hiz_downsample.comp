#version 450
// Hi-Z depth pyramid downsample (one dispatch per mip level).
//
// Two flavors, selected by push.aoFilter:
//
//   SSR chains (aoFilter=0): mip 0 is a per-texel copy of the opaque GBuffer
//   depth (D32, bound as a sampler) into R32F; each further mip max-reduces
//   the previous one 2x2.  The projection is standard (non-reversed) Vulkan
//   depth:
//   0 = near, 1 = far, so a ray marcher testing "ray behind the cell" needs
//   the FARTHEST surface per cell -> max-reduce.  Sky pixels (cleared depth
//   1.0) dominate any mixed cell; the marcher treats the far value as
//   +infinity and skips such cells at speed (the standard Hi-Z tradeoff, see
//   ssr.glsl).
//
//   AO chains (aoFilter=1): the GTAO main pass (ssao.comp) marches this chain
//   at a per-step LOD (XeGTAO depth MIP sampling).  The chain stores LINEAR
//   view-space Z like XeGTAO's working depth: level 0 is a true per-texel
//   NDC->viewZ copy, and each further mip is XeGTAO's DepthMIPFilter — a
//   far-biased weighted average of the 2x2 inputs, where weights follow the
//   AO effect-radius falloff.  The far bias keeps thin near occluders from
//   smearing false occlusion (halos) across coarse-mip footprints; a pure
//   min-reduce would over-darken silhouettes, a pure max-reduce leaks light
//   on coherent surfaces.
//
// Ref: Jimenez et al., "Practical Real-Time Strategies for Accurate Indirect
//      Occlusion" (GTAO), SIGGRAPH 2016
//      Intel XeGTAO, https://github.com/GameTechDev/XeGTAO
//      (XeGTAO_PrefilterDepths16x16 / XeGTAO_DepthMIPFilter)
//      McGuire & Mara, "Efficient GPU Screen-Space Ray Tracing", JCGT 2014
//      Stachowiak, Stochastic SSR, SIGGRAPH 2015
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTex;
layout(set = 0, binding = 1, r32f) writeonly uniform image2D dstMip;

layout(push_constant) uniform Push {
    ivec2 srcSize;   // texel size of srcTex (clamps the 2x2 tap on odd sizes)
    int aoFilter;    // 0 = SSR max-reduce, 1 = XeGTAO DepthMIPFilter (view-Z chain)
    int level;       // AO chains: level 0 is the per-texel NDC->viewZ copy
    vec2 depthUnpack; // viewZ = x / (y - ndcDepth); AO chains only
    vec2 falloff;     // x = falloffMul, y = falloffAdd (DepthMIPFilter weights)
} push;

void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(dstMip);
    if (dst.x >= dstSize.x || dst.y >= dstSize.y) return;

    // Level 0 is a true per-texel copy of the source depth for BOTH flavors
    // (AO converts NDC -> view-Z here; the SSR chain keeps NDC depth).  Every
    // consumer — the SSR marchers (ssr.glsl: mipSize = size0 >> level) and the
    // Phase 7a occlusion cull — assumes mip L has resolution size0 >> L, so a
    // 2x2 max at level 0 would silently halve the chain's effective resolution.
    if (push.level == 0) {
        float d = texelFetch(srcTex, min(dst, push.srcSize - 1), 0).r;
        if (push.aoFilter == 1)
            d = push.depthUnpack.x / max(push.depthUnpack.y - d, 1e-6);
        imageStore(dstMip, dst, vec4(d));
        return;
    }

    // Edge replication on odd dimensions: a cell at the right/bottom border
    // re-samples the edge texel instead of clamping AFTER the fetch.
    ivec2 lo = min(dst * 2, push.srcSize - 1);
    ivec2 hi = min(dst * 2 + 1, push.srcSize - 1);
    float d00 = texelFetch(srcTex, ivec2(lo.x, lo.y), 0).r;
    float d10 = texelFetch(srcTex, ivec2(hi.x, lo.y), 0).r;
    float d01 = texelFetch(srcTex, ivec2(lo.x, hi.y), 0).r;
    float d11 = texelFetch(srcTex, ivec2(hi.x, hi.y), 0).r;

    if (push.aoFilter == 1) {
        // XeGTAO_DepthMIPFilter (inputs are view Z at level >= 1): weights
        // fall off with the depth distance from the FARTHEST texel.
        float maxDepth = max(max(d00, d10), max(d01, d11));
        float w0 = clamp((maxDepth - d00) * push.falloff.x + push.falloff.y, 0.0, 1.0);
        float w1 = clamp((maxDepth - d10) * push.falloff.x + push.falloff.y, 0.0, 1.0);
        float w2 = clamp((maxDepth - d01) * push.falloff.x + push.falloff.y, 0.0, 1.0);
        float w3 = clamp((maxDepth - d11) * push.falloff.x + push.falloff.y, 0.0, 1.0);
        float wsum = w0 + w1 + w2 + w3;
        imageStore(dstMip, dst, vec4((w0 * d00 + w1 * d10 + w2 * d01 + w3 * d11) / wsum));
        return;
    }

    imageStore(dstMip, dst, vec4(max(max(d00, d10), max(d01, d11))));
}
