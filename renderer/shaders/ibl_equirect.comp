#version 450
// Equirectangular HDR -> cubemap mip 0.  One invocation per texel per face
// (gl_GlobalInvocationID.z = cube layer, Vulkan cube face order).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D equirect;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray dstCube;

const float PI = 3.14159265359;

// Vulkan cube-face direction, uv in [-1,1] (y down in face space).
vec3 cubeDir(uint face, vec2 uv) {
    switch (face) {
    case 0u: return vec3(1.0, -uv.y, -uv.x);   // +X
    case 1u: return vec3(-1.0, -uv.y, uv.x);   // -X
    case 2u: return vec3(uv.x, 1.0, uv.y);     // +Y
    case 3u: return vec3(uv.x, -1.0, -uv.y);   // -Y
    case 4u: return vec3(uv.x, -uv.y, 1.0);    // +Z
    default: return vec3(-uv.x, -uv.y, -1.0);  // -Z
    }
}

vec2 equirectUv(vec3 dir) {
    float u = atan(dir.z, dir.x) / (2.0 * PI) + 0.5;
    float v = acos(clamp(dir.y, -1.0, 1.0)) / PI;
    return vec2(u, v);
}

void main() {
    ivec3 size = imageSize(dstCube);
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (id.x >= size.x || id.y >= size.y) return;
    vec2 uv = (vec2(id.xy) + 0.5) / vec2(size.xy) * 2.0 - 1.0;
    vec3 dir = cubeDir(uint(id.z), uv);
    vec3 color = textureLod(equirect, equirectUv(dir), 0.0).rgb;
    imageStore(dstCube, id, vec4(color, 1.0));
}
