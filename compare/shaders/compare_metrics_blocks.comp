#version 450
// Metrics pass 1: per-block reduction of PSNR/SSIM intermediate quantities.
//
// Metric convention (matches the offline metrics pipeline, metrics/
// compute_metrics.py, which reads tonemapped PNGs): both images are linear
// HDR, mapped to [0,1] via Reinhard tonemap + gamma 2.2 (identical to the
// present pass / screenshot path), then compared in that sRGB-like domain
// with data_range = 1.  SSIM is approximated block-wise: each 8x8 workgroup
// covers one non-overlapping block and produces the standard SSIM terms with
// C1 = 0.01^2, C2 = 0.03^2; pass 2 averages the per-block values.
//
// Each workgroup writes 8 floats to uBlocks[blockIndex]:
//   [0..2] sum of squared differences (R,G,B)
//   [3]    valid pixel count
//   [4..6] block SSIM (R,G,B)
//   [7]    1.0 (block count)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uTest;
layout(set = 0, binding = 1) uniform sampler2D uRef;
layout(std430, set = 0, binding = 2) writeonly buffer Blocks { float data[]; } uBlocks;

layout(push_constant) uniform Push {
    uvec4 p; // xy = region offset (px), zw = region extent (px)
    uvec4 q; // x  = blocks per row within the region
             // y  = 1 => uRef is low-res (GT Apply scale): sample via
             //      normalized UVs instead of texelFetch
             // zw = test image full size (px), for the normalized UVs
} pc;

const float C1 = 0.01 * 0.01;
const float C2 = 0.03 * 0.03;

// Reinhard + gamma 2.2 -> [0,1], same as present.frag / savePngFromHalfRgba.
vec3 metricDomain(vec3 hdr) {
    vec3 c = hdr / (1.0 + hdr);
    return pow(max(c, vec3(0.0)), vec3(1.0 / 2.2));
}

shared vec3 sX[64];
shared vec3 sY[64];
shared vec3 sXX[64];
shared vec3 sYY[64];
shared vec3 sXY[64];
shared vec3 sD2[64];
shared float sCount[64];

void main() {
    const uint lane = gl_LocalInvocationIndex;
    // Global invocation covers the metric region only; px is absolute.
    const ivec2 px = ivec2(pc.p.xy) + ivec2(gl_GlobalInvocationID.xy);
    const bool valid = gl_GlobalInvocationID.x < pc.p.z && gl_GlobalInvocationID.y < pc.p.w;

    vec3 x = vec3(0.0);
    vec3 y = vec3(0.0);
    if (valid) {
        x = metricDomain(texelFetch(uTest, px, 0).rgb);
        if (pc.q.y != 0u) {
            // Low-res GT reference: bilinear-sample at the matching
            // normalized position in test-image space.
            const vec2 uv = (vec2(px) + 0.5) / vec2(pc.q.zw);
            y = metricDomain(texture(uRef, uv).rgb);
        } else {
            y = metricDomain(texelFetch(uRef, px, 0).rgb);
        }
    }

    sX[lane] = x;
    sY[lane] = y;
    sXX[lane] = x * x;
    sYY[lane] = y * y;
    sXY[lane] = x * y;
    const vec3 d = x - y;
    sD2[lane] = d * d;
    sCount[lane] = valid ? 1.0 : 0.0;
    barrier();

    for (uint s = 32; s > 0; s >>= 1) {
        if (lane < s) {
            sX[lane] += sX[lane + s];
            sY[lane] += sY[lane + s];
            sXX[lane] += sXX[lane + s];
            sYY[lane] += sYY[lane + s];
            sXY[lane] += sXY[lane + s];
            sD2[lane] += sD2[lane + s];
            sCount[lane] += sCount[lane + s];
        }
        barrier();
    }

    if (lane == 0) {
        const float n = max(sCount[0], 1.0);
        const vec3 muX = sX[0] / n;
        const vec3 muY = sY[0] / n;
        const vec3 varX = max(sXX[0] / n - muX * muX, vec3(0.0));
        const vec3 varY = max(sYY[0] / n - muY * muY, vec3(0.0));
        const vec3 covXY = sXY[0] / n - muX * muY;
        const vec3 ssim = ((2.0 * muX * muY + C1) * (2.0 * covXY + C2))
                        / ((muX * muX + muY * muY + C1) * (varX + varY + C2));

        const uint blockIdx = gl_WorkGroupID.y * pc.q.x + gl_WorkGroupID.x;
        uBlocks.data[blockIdx * 8 + 0] = sD2[0].r;
        uBlocks.data[blockIdx * 8 + 1] = sD2[0].g;
        uBlocks.data[blockIdx * 8 + 2] = sD2[0].b;
        uBlocks.data[blockIdx * 8 + 3] = n;
        uBlocks.data[blockIdx * 8 + 4] = ssim.r;
        uBlocks.data[blockIdx * 8 + 5] = ssim.g;
        uBlocks.data[blockIdx * 8 + 6] = ssim.b;
        uBlocks.data[blockIdx * 8 + 7] = 1.0;
    }
}
